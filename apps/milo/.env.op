# 1Password secret references. Safe to commit: no secret values here.
# Run with: op run --env-file=.env.op -- <command>
# Without 1Password, keep using .env.local.
NODE_ENV=development
AUTH_SECRET=op://Env/meeboter-apps-milo/AUTH_SECRET
AUTH_GITHUB_ID=op://Env/meeboter-apps-milo/AUTH_GITHUB_ID
AUTH_GITHUB_SECRET=op://Env/meeboter-apps-milo/AUTH_GITHUB_SECRET
DATABASE_URL=op://Env/meeboter-apps-milo/DATABASE_URL
DATABASE_SSL=false
NEXT_PUBLIC_APP_ORIGIN_URL=http://localhost:3000
MILO_AUTH_TOKEN=op://Env/meeboter-apps-milo/MILO_AUTH_TOKEN
GHCR_ORG=op://Env/meeboter-apps-milo/GHCR_ORG
S3_ENDPOINT=op://Env/meeboter-apps-milo/S3_ENDPOINT
S3_ACCESS_KEY=op://Env/meeboter-apps-milo/S3_ACCESS_KEY
S3_SECRET_KEY=op://Env/meeboter-apps-milo/S3_SECRET_KEY
S3_BUCKET_NAME=op://Env/meeboter-apps-milo/S3_BUCKET_NAME
S3_REGION=op://Env/meeboter-apps-milo/S3_REGION
PLATFORM_PRIORITY=local
GLOBAL_QUEUE_TIMEOUT_MS=600000
DEPLOYMENT_QUEUE_MAX_CONCURRENT=4
COOLIFY_API_URL=op://Env/meeboter-apps-milo/COOLIFY_API_URL
COOLIFY_API_TOKEN=op://Env/meeboter-apps-milo/COOLIFY_API_TOKEN
COOLIFY_PROJECT_UUID=op://Env/meeboter-apps-milo/COOLIFY_PROJECT_UUID
COOLIFY_SERVER_UUID=op://Env/meeboter-apps-milo/COOLIFY_SERVER_UUID
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_DESTINATION_UUID=op://Env/meeboter-apps-milo/COOLIFY_DESTINATION_UUID
COOLIFY_BOT_LIMIT=20
COOLIFY_QUEUE_TIMEOUT_MS=300000
